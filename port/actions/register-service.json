{
  "identifier": "register_existing_service",
  "title": "Register Existing Service",
  "icon": "Microservice",
  "description": "Register an existing service into the Port catalog by providing its repository details.",
  "trigger": {
    "type": "self-service",
    "operation": "CREATE",
    "userInputs": {
      "properties": {
        "service_name": {
          "title": "Service Name",
          "type": "string",
          "description": "Unique identifier for the service (lowercase, hyphens allowed)",
          "pattern": "^[a-z0-9-]+$"
        },
        "github_org": {
          "title": "GitHub Organization",
          "type": "string",
          "description": "GitHub organization or user that owns the repository"
        },
        "repo_name": {
          "title": "Repository Name",
          "type": "string",
          "description": "Name of the existing GitHub repository"
        },
        "language": {
          "title": "Language",
          "type": "string",
          "icon": "Git",
          "enum": [
            "python",
            "typescript",
            "go",
            "java",
            "rust",
            "other"
          ],
          "enumColors": {
            "python": "blue",
            "typescript": "blue",
            "go": "turquoise",
            "java": "orange",
            "rust": "red",
            "other": "lightGray"
          }
        },
        "tier": {
          "title": "Tier",
          "type": "string",
          "description": "How mission-critical the service is",
          "enum": [
            "Mission Critical",
            "Customer Facing",
            "Internal Service",
            "Other"
          ],
          "enumColors": {
            "Mission Critical": "turquoise",
            "Customer Facing": "green",
            "Internal Service": "darkGray",
            "Other": "yellow"
          },
          "default": "Internal Service"
        },
        "slack": {
          "title": "Slack Channel",
          "type": "string",
          "icon": "Slack",
          "description": "Slack channel URL for this service",
          "format": "url"
        }
      },
      "required": [
        "service_name",
        "repo_name",
        "github_org",
        "language",
        "tier"
      ]
    },
    "blueprintIdentifier": "service"
  },
  "invocationMethod": {
    "type": "INTEGRATION_ACTION",
    "installationId": "github-ocean",
    "integrationActionType": "dispatch_workflow",
    "integrationActionExecutionProperties": {
      "org": "eduardopiairo",
      "repo": "platform-engineering",
      "workflow": "port-register-service.yml",
      "workflowInputs": {
        "{{ spreadValue() }}": "{{ .inputs }}",
        "port_context": {
          "runId": "{{ .run.id }}",
          "blueprint": "{{ .action.blueprint }}"
        }
      },
      "reportWorkflowStatus": true
    }
  },
  "allowAnyoneToViewRuns": true,
  "requiredApproval": false
}
